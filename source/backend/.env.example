# ============================================================
#  Template environment backend — SALIN ke .env lalu isi nilainya.
#  cp .env.example .env
# ============================================================

# --- LLM (OpenRouter) ---
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEFAULT_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_APP_URL=http://localhost:5173
OPENROUTER_APP_NAME=Feri Personal Site

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,https://your-site.netlify.app

# --- Persistensi ---
DB_BACKEND=sqlite                 # "sqlite" (dev) | "turso" (prod)
SQLITE_PATH=./data/chat.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Rate limiting ---
RATE_LIMIT_PER_MIN=20

# --- App ---
APP_ENV=development
